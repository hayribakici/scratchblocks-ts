{
  "name": "scratchblocks-ts",
  "version": "0.1.1",
  "description": "Framework-agnostic Scratchblocks rendering and Markdown extraction",
  "license": "MIT",
  "keywords": [
    "scratch",
    "scratchblocks",
    "markdown",
    "svg",
    "renderer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hayribakici/scratchblocks-ts.git"
  },
  "bugs": {
    "url": "https://github.com/hayribakici/scratchblocks-ts/issues"
  },
  "homepage": "https://github.com/hayribakici/scratchblocks-ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist/index.*",
    "dist/markdown.*",
    "dist/renderer.*",
    "dist/types.*",
    "dist/lru-cache.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "esbuild tests/index.ts --bundle --platform=node --outfile=/tmp/scratchblocks-ts.test.js && node /tmp/scratchblocks-ts.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "scratchblocks": "3.7.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^4.8.2"
  }
}
