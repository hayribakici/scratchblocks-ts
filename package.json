{
  "name": "scratchblocks-ts",
  "version": "0.1.2",
  "description": "Scratchblocks rendering for TypeScript",
  "license": "MIT",
  "keywords": [
    "scratch",
    "scratchblocks",
    "svg",
    "renderer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hayribakici/scratchblocks-ts.git"
  },
  "bugs": {
    "url": "https://github.com/hayribakici/scratchblocks-ts/issues"
  },
  "homepage": "https://github.com/hayribakici/scratchblocks-ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist/index.*",
    "dist/renderer.*",
    "dist/types.*",
    "dist/lru-cache.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --dir tests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "scratchblocks": "3.7.1"
  },
  "devDependencies": {
    "typescript": "^4.8.2",
    "vitest": "^4.1.10"
  }
}
